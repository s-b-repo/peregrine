# Rust build output (workspace-shared target dir; Cargo.lock IS committed — binaries)
/target
**/*.rs.bk

# Coverage / profiling artifacts
*.profraw
perf.data
perf.data.old
flamegraph.svg

# Claude Code machine-local permission grants (shared config would go in .claude/settings.json)
.claude/settings.local.json

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# OS noise
.DS_Store
Thumbs.db

# Ad-hoc benchmark working dirs (curated results live in bench-data/)
/bench-results/
/b1-isolate/
/b16-repeat/
/bench-results.log
/b1-isolate.log
/b16-repeat.log
# Long-run scratch logs. Their durable content is transcribed into todo.md and
