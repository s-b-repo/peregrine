# before they cost a disk read. One variable against stale-off.env. Slack left
# at its default (1 layer-step past the emit stamp).
export COLI_ECACHE_GB=8
export COLI_IO_BATCH=8
export COLI_KV_BUDGET_MB=4096
export COLI_PREFETCH_STALE_DROP=1
