# Middle arm: topic steering ON but decay OFF (COLI_TOPIC_HALFLIFE=0) — the
# static all-time-counter profile. Isolates the adaptive-decay contribution:
# topic-static vs topic-on (adaptive) is the value of aging; topic-off vs
# topic-static is the value of steering at all.
export COLI_ECACHE_GB=8
export COLI_IO_BATCH=8
export COLI_KV_BUDGET_MB=4096
export COLI_TOPIC_ROUTING=1
export COLI_TOPIC_HALFLIFE=0
