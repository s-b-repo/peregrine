# Candidate arm: topic routing on WITH adaptive decay (COLI_TOPIC_HALFLIFE
# defaults to 512, scaled down by routing entropy). Profiles track recent
# routing and re-form on a topic shift. vs topic-static.env this isolates the
# adaptive-aging contribution; vs topic-off.env it's the whole feature.
export COLI_ECACHE_GB=8
export COLI_IO_BATCH=8
export COLI_KV_BUDGET_MB=4096
export COLI_TOPIC_ROUTING=1
