# Candidate arm: topic-based smart routing on. The evictor breaks protection
# ties by the ACTIVE topic's expert-usage frequency, so a request keeps its
# topic-hot experts resident across interleaved off-topic traffic. One variable
# against topic-off.env. Read at model build.
export COLI_ECACHE_GB=8
export COLI_IO_BATCH=8
export COLI_KV_BUDGET_MB=4096
export COLI_TOPIC_ROUTING=1
