# Candidate arm: device-pure io claims — the rings claim per-device windows
# (home + steal) so no deep submit reaps behind a slower device. One variable
# against device-off.env. Read at model build, so envarms' fresh process per
# arm-rep samples it correctly.
export COLI_ECACHE_GB=8
export COLI_IO_BATCH=8
export COLI_KV_BUDGET_MB=4096
export COLI_IO_DEVICE_SCHED=1
