# Candidate arm: ds4-style auto budget — COLI_ECACHE_AUTO_FRAC (default 0.8)
# of post-load MemAvailable, still passed through cap_ecache_budget's
# transient-reserve and 1 GiB safety subtraction. One variable against
# ecache8.env: the budget spelling.
export COLI_ECACHE_GB=auto
export COLI_IO_BATCH=8
export COLI_KV_BUDGET_MB=4096
