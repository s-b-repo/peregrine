export COLI_FUSE_PREFILL=1         # 322 vs 356 s (1.11x), output byte-identical
export COLI_CACHE_SWEEP=1          # sweep victim + built-in admission refusal; decode_s 350->275
export COLI_IO_BATCH=8             # stream reserve 11.5->~6.4 GB; decode claims (ceil-divide) unaffected. A/B vs 16: prefill ttft
export COLI_ECACHE_GB=8            # re-invest the freed reserve in the warm cache (cap_ecache_budget still clamps)
export COLI_KV_BUDGET_MB=4096      # guard for deep-batch KV growth (f32, ~175 KiB/tok/stream)
export MALLOC_ARENA_MAX=2
