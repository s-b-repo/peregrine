# The 2026-08-13 defaults, as shipped: COLI_FUSE_PREFILL=1,
# COLI_PREFILL_CHUNK_DIV=4, COLI_PREFIX_CACHE_MB=2048 all come from the binary.
# Shared workload knobs mirror the 2026-08-10 M2 sweep so the two datasets read
# against each other.
export COLI_ECACHE_GB=8
export COLI_IO_BATCH=8
export COLI_KV_BUDGET_MB=4096
