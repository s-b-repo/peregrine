# Candidate arm: same depth-5 drafting, but stop the draft early when the MTP
# head's top-token probability drops under 0.65 (ds4's CUDA default is 0.7,
# Metal 0.6). One variable against draft5.env: the confidence floor.
export COLI_ECACHE_GB=8
export COLI_IO_BATCH=8
export COLI_KV_BUDGET_MB=4096
export COLI_DRAFT=5
export COLI_SPEC_CONF=0.65
