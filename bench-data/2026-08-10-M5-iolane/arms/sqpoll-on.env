# M1 profile.env verbatim (inlined, not sourced — see the M3 arms that silently
# degraded when their sourced winner.env vanished), plus the io-lane delta below.
export COLI_FUSE_PREFILL=1         # 322 vs 356 s (1.11x), output byte-identical
export COLI_CACHE_SWEEP=1          # sweep victim + built-in admission refusal; decode_s 350->275
export COLI_IO_BATCH=8             # stream reserve 11.5->~6.4 GB; decode claims (ceil-divide) unaffected
export COLI_ECACHE_GB=8            # re-invest the freed reserve in the warm cache (cap_ecache_budget still clamps)
export COLI_KV_BUDGET_MB=4096      # guard for deep-batch KV growth (f32, ~175 KiB/tok/stream)
export COLI_PREFETCH_WARM_PATHS=0  # prefetch off: 0.3% yield, 14:1 reads-against
export COLI_PREFETCH_HINT_PATHS=0  # (the off-switch is these two, not COLI_PREFETCH_LANES, which floors at 1)
export MALLOC_ARENA_MAX=2
# --- io-lane delta ---
export COLI_IO_COMPLETION=1        # same completion lane as the sqpoll-off arm (io-completion.env)
export COLI_SQPOLL=1               # kernel SQ-polling kthreads on the 4 streaming rings: no enter syscall per submit
# COLI_SQPOLL_IDLE_MS left at 2000: awake across intra-token gaps, asleep between requests.
# The risk being measured: 4 poll kthreads busy-polling vs dm-crypt's own CPU appetite on 12 cores.
