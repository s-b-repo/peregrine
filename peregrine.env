# peregrine runtime configuration — this machine (46 GB RAM, 12 CPUs, RTX 3060 12 GB).
# Usage:  . ./peregrine.env
# Every knob has a working default; this file sets only what the machine needs.
# Full reference: docs/configuration.md  (six knobs change token values — none set here)

# Default model: the frontier streaming container (measured 2026-09-25).
# The old /srv/modelstripe/qwen/Qwen3.8-27B-peregrine resident container is GONE
# (/srv/modelstripe is empty), so this default no longer points at a dead path.
#   /srv/m-sdd/GLM-5.3-Flash-4ssd  — 45 layers, 288 experts, 3 SSDs, model_paths.json
# For fast interactive chat use Ollama instead (`qwen3:30b-a3b`, already pulled);
# peregrine's other local container is GLM-5.2-r5 (744B, 5 drives, ~0.064 tok/s).
export COLI_MODEL=/srv/m-sdd/GLM-5.3-Flash-4ssd

# GPU lane — two binary trees, so feature sets don't churn each other's artifacts:
#   target/release/*       CPU-only  (plain `cargo build --release` / `cargo test`)
#   target-cuda/release/*  CUDA-enabled (built with --features cuda)
# The lane itself is runtime opt-in (RTX 3060, compute capability 8.6):
# export COLI_GPU=1
# export COLI_GPU_INT4=1        # int4 VRAM tier (per-row int4 experts)

# Everything below is auto-derived and listed only to document the choice.
# COLI_STREAM          auto     126 GB GLM streams; 14 GB Qwen stays resident
# COLI_ECACHE_GB       auto     10 % of available RAM, capped at 2 GiB
# COLI_IO_ENGINE       auto     kernel 7.1 probes io_uring and uses it
# COLI_IO_RINGS        4        ~11.5 GB projected streaming buffers
# COLI_PAR_THREADS     12       (ncpus)
